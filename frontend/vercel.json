{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arthamaesthetique.com" }],
      "destination": "https://www.arthamaesthetique.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arthamaesthetic.com" }],
      "destination": "https://www.arthamaesthetique.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.arthamaesthetic.com" }],
      "destination": "https://www.arthamaesthetique.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/studio/:path*", "destination": "/studio/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
